{
  "schema": "experiment/1",
  "experiment_id": "faults.multipart-abort",
  "card": "faults",
  "case_id": "multipart-abort",
  "policies": [
    "s3",
    "s3plain",
    "cas"
  ],
  "replicas": 1,
  "mode": "deterministic",
  "controls": {
    "merges": "stop",
    "gc": "off",
    "ttl": "none"
  },
  "settings": {
    "table": {
      "max_parts_to_merge_at_once": 1
    },
    "query": {},
    "server": {
      "s3_retry_attempts": "1"
    }
  },
  "params": {
    "replica": "r1",
    "seed": 20261024,
    "columns": "k UInt64, s String CODEC(NONE)",
    "order_by": "k",
    "insert": "INSERT INTO {table} SELECT number, repeat(hex(sipHash64(number, {seed})), 64) FROM numbers({rows})",
    "rows": 40000,
    "inserts": 1,
    "expect_insert_failure": true,
    "expected_failed_attempts": {
      "s3": 4,
      "s3plain": 4,
      "cas": 32
    },
    "expect_retry_chain": false,
    "faults": [
      {
        "caller": "r1",
        "op": "UploadPart",
        "part_number": 2,
        "nth": "*",
        "action": {
          "type": "status",
          "status": 500,
          "send_upstream": false
        }
      }
    ]
  },
  "scale": 1.0,
  "repeats": 3,
  "timeout_s": 900,
  "description": "One insert whose CODEC(NONE) String column file (about 41 MB) is a two-part multipart upload; every UploadPart of part 2 is answered 500 without reaching the store, so the INSERT fails and the server aborts the upload itself. s3_retry_attempts = 1 bounds the retries (4 attempts)."
}
