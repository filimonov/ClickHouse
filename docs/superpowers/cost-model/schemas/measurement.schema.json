            {
              "type": "null"
            }
          ]
        },
        "commit": {
          "type": "string",
          "description": "source commit the binary was built from"
        },
        "rig_commit": {
          "type": "string",
          "description": "HEAD of the rig worktree that produced the record"
        },
        "pass_dir": {
          "type": "string"
        },
        "status": {
          "const": "UNSUPPORTED"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "measurement_id",
        "experiment_id",
        "run_id",
        "card",
        "case_id",
        "policy",
        "variant",
        "cache_enabled",
        "replicas",
        "k",
        "scale",
        "mode",
        "binary_sha256",
        "binary_download_sha256",
        "commit",
        "rig_commit",
        "pass_dir",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
