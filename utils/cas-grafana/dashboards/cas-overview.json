      "targets": [
        {
          "database": "system",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "dateColDataType": "event_date",
          "dateTimeColDataType": "event_time",
          "dateTimeType": "DATETIME",
          "extrapolate": false,
          "format": "table",
          "intervalFactor": 1,
          "query": "SELECT if(count() = 0, NULL, dateDiff('minute', max(event_time), now())) AS \"Minutes since last success\" /* now */\nFROM clusterAllReplicas('$cluster', system.cas_gc_log)\nWHERE disk_name IN ($disk) AND event_type = 'Finish' AND outcome IN ('Success', 'Deferred') AND event_date >= today() - 7\nSETTINGS skip_unavailable_shards = 1",
          "rawQuery": "",
          "refId": "A",
          "round": "0s",
          "skip_comments": false,
