    {
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "description": "Is garbage collection keeping up with deletions? Each round marks objects for deletion and deletes objects marked earlier. Backlog growth: over the last 10 rounds, the share of newly marked objects that were not yet deleted; near zero is steady state, it rises for about an hour after a server restart and recovers by itself. Yellow above 25%, red above 50%. Net objects: marked minus deleted over those rounds. What to do: if red for more than two hours, open Drilldown \u2192 GC: stage flow and GC: round cost.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "match": "null",
                "result": {
                  "color": "#8e8e8e",
                  "index": 0,
                  "text": "no data"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Backlog growth %, last 10 rounds"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 25
                    },
                    {
                      "color": "red",
                      "value": 50
                    }
                  ]
                }
              },
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Net objects, last 10 rounds"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 12,
        "y": 0
