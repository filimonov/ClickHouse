{
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "vertamedia-clickhouse-datasource",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "name": "Restart",
        "target": {
          "annotation": true,
          "database": "system",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "dateColDataType": "event_date",
          "dateTimeColDataType": "event_time",
          "dateTimeType": "DATETIME",
          "extrapolate": false,
          "format": "table",
          "intervalFactor": 1,
          "query": "SELECT toUInt64(event_time) * 1000 AS time, concat('Restart: ', host) AS text, 'restart' AS tags\nFROM (SELECT hostName() AS host, event_time, value,\n             lagInFrame(value, 1) OVER (PARTITION BY hostName() ORDER BY event_time) AS prev\n      FROM clusterAllReplicas('$cluster', system.asynchronous_metric_log)\n      WHERE metric = 'Uptime' AND hostName() IN ($host) AND $timeFilter)\nWHERE prev > value\nSETTINGS skip_unavailable_shards = 1",
          "rawQuery": "",
          "refId": "A",
          "round": "0s",
          "skip_comments": false,
          "table": "asynchronous_metric_log"
        }
      },
      {
        "datasource": {
          "type": "vertamedia-clickhouse-datasource",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Lease lost",
        "target": {
          "annotation": true,
          "database": "system",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "dateColDataType": "event_date",
          "dateTimeColDataType": "event_time",
          "dateTimeType": "DATETIME",
          "extrapolate": false,
          "format": "table",
          "intervalFactor": 1,
          "query": "SELECT toUInt64(event_time) * 1000 AS time, concat('Lease lost: ', hostName()) AS text, 'lease' AS tags\nFROM clusterAllReplicas('$cluster', system.metric_log)\nWHERE ProfileEvent_CASMountLeaseLost > 0 AND hostName() IN ($host) AND $timeFilter\nSETTINGS skip_unavailable_shards = 1",
          "rawQuery": "",
          "refId": "A",
          "round": "0s",
          "skip_comments": false,
          "table": "metric_log"
        }
      }
    ]
  },
  "description": "Health of content-addressed (CAS) storage for people who run the cluster: is storage online, are writes safe, is garbage collection keeping up, is anything wrong. Details for support engineers are on CAS / Drilldown.",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "title": "CAS / Drilldown",
      "type": "link",
      "url": "/d/cas-drilldown/cas-drilldown?${__url_time_range}&${__all_variables}"
    },
    {
      "icon": "doc",
      "targetBlank": true,
      "title": "Operations: monitoring",
      "type": "link",
      "url": "https://docs.altinity.com/antalya/cas/operations/monitoring"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "description": "Every host can read and write the shared storage right now. Hosts not reporting: hosts in the cluster that did not answer. Disks not live: storage disks that lost their connection to the pool. Lease lost: how many times a host lost its write permission in the selected period. Metrics age: seconds since the last metrics row; when the storage is down the server stops writing its own logs, so a growing age is itself a warning. What to do: check the host and its object storage endpoint; see Drilldown \u2192 Writes: lease and Writes: mounts now.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "match": "null",
                "result": {
                  "color": "#8e8e8e",
                  "index": 0,
                  "text": "no data"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hosts not reporting"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Disks not live"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Lease lost"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Metrics age (s)"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 120
                    },
                    {
                      "color": "red",
                      "value": 600
                    }
                  ]
                }
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "interval": "5m",
      "links": [
        {
          "targetBlank": false,
          "title": "Open CAS / Drilldown",
          "url": "/d/cas-drilldown/cas-drilldown?${__url_time_range}&${__all_variables}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": false
      },
      "targets": [
        {
          "database": "system",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "dateColDataType": "event_date",
          "dateTimeColDataType": "event_time",
          "dateTimeType": "DATETIME",
          "extrapolate": false,
          "format": "table",
          "intervalFactor": 1,
          "query": "SELECT\n    (SELECT count() FROM system.clusters WHERE cluster = '$cluster') - uniqExact(host) AS \"Hosts not reporting\",\n    countIf(lifecycle != 'live') AS \"Disks not live\"\nFROM (SELECT hostName() AS host, disk, any(lifecycle) AS lifecycle\n      FROM clusterAllReplicas('$cluster', system.cas_mounts)\n      WHERE disk IN ($disk)\n      GROUP BY host, disk)\nSETTINGS skip_unavailable_shards = 1",
          "rawQuery": "",
          "refId": "A",
          "round": "0s",
          "skip_comments": false,
          "table": "cas_mounts"
        },
        {
          "database": "system",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "dateColDataType": "event_date",
          "dateTimeColDataType": "event_time",
          "dateTimeType": "DATETIME",
          "extrapolate": false,
          "format": "table",
          "intervalFactor": 1,
          "query": "SELECT if(count() = 0, NULL, sum(ProfileEvent_CASMountLeaseLost)) AS \"Lease lost\",\n    dateDiff('second', max(event_time), now()) AS \"Metrics age (s)\"\nFROM clusterAllReplicas('$cluster', system.metric_log)\nWHERE hostName() IN ($host) AND $timeFilter\nSETTINGS skip_unavailable_shards = 1",
          "rawQuery": "",
          "refId": "B",
          "round": "0s",
          "skip_comments": false,
          "table": "metric_log"
        }
      ],
      "title": "Storage online",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${datasource}"
      },
      "description": "Writes to the shared storage are confirmed. Gave up: writes abandoned after all retries (any value needs a look). Unresolved %: share of writes whose answer from the storage was lost and had to be re-checked by reading back; 0.03% is normal on a healthy backend, a rise means storage timeouts. What to do: check object-storage latency and errors; see Drilldown \u2192 Writes: conditional writes and S3: errors and throttling.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "match": "null",
                "result": {
                  "color": "#8e8e8e",
                  "index": 0,
                  "text": "no data"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Gave up"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unresolved %"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.1
                    }
                  ]
                }
              },
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "links": [
        {
          "targetBlank": false,
          "title": "Open CAS / Drilldown",
          "url": "/d/cas-drilldown/cas-drilldown?${__url_time_range}&${__all_variables}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": false
      },
      "targets": [
        {
          "database": "system",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "dateColDataType": "event_date",
          "dateTimeColDataType": "event_time",
          "dateTimeType": "DATETIME",
          "extrapolate": false,
          "format": "table",
          "intervalFactor": 1,
          "query": "SELECT if(count() = 0, NULL, sum(ProfileEvent_CASRequestGaveUp)) AS \"Gave up\",\n    if(sum(ProfileEvent_CASConditionalWriteAttempts) = 0, NULL,\n       round(100 * sum(ProfileEvent_CASConditionalWriteUnresolved) / sum(ProfileEvent_CASConditionalWriteAttempts), 3)) AS \"Unresolved %\"\nFROM clusterAllReplicas('$cluster', system.metric_log)\nWHERE hostName() IN ($host) AND $timeFilter\nSETTINGS skip_unavailable_shards = 1",
          "rawQuery": "",
          "refId": "A",
          "round": "0s",
          "skip_comments": false,
          "table": "metric_log"
        }
      ],
      "title": "Writes safe",
      "type": "stat"
    },
