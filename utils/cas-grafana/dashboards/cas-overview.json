      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": false
      },
      "targets": [
        {
          "database": "system",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${datasource}"
          },
          "dateColDataType": "event_date",
          "dateTimeColDataType": "event_time",
          "dateTimeType": "DATETIME",
          "extrapolate": false,
          "format": "table",
          "intervalFactor": 1,
          "query": "SELECT if(count() = 0, NULL, round(100 * sum(net) / greatest(sum(cond), 1), 1)) AS \"Backlog growth %, last 10 rounds\",\n       if(count() = 0, NULL, sum(net)) AS \"Net objects, last 10 rounds\" /* now */\nFROM (SELECT toInt64(entries_condemned) - toInt64(entries_redeleted) AS net, toInt64(entries_condemned) AS cond\n      FROM clusterAllReplicas('$cluster', system.cas_gc_log)\n      WHERE disk_name IN ($disk) AND event_type = 'Finish' AND outcome = 'Success' AND event_date >= today() - 7\n      ORDER BY event_time DESC LIMIT 10)\nSETTINGS skip_unavailable_shards = 1",
          "rawQuery": "",
          "refId": "A",
          "round": "0s",
          "skip_comments": false,
          "table": "cas_gc_log"
